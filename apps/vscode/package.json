{
  "name": "skill-bridge-vscode",
  "displayName": "Skill Bridge",
  "description": "Workspace/Central skill viewer and sync",
  "version": "0.2.4",
  "private": true,
  "publisher": "skill-bridge",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:skillBridge.workspaceSkills",
    "onView:skillBridge.centralSkills",
    "onCommand:skillBridge.refresh",
    "onCommand:skillBridge.switchTab",
    "onCommand:skillBridge.promoteSelected",
    "onCommand:skillBridge.importSelected",
    "onCommand:skillBridge.createWorkspaceGroup",
    "onCommand:skillBridge.createCentralGroup",
    "onCommand:skillBridge.promoteGroup",
    "onCommand:skillBridge.importGroup",
    "onCommand:skillBridge.selectGroup",
    "onCommand:skillBridge.deleteGroup",
    "onCommand:skillBridge.groupActions",
    "onCommand:skillBridge.renameGroup",
    "onCommand:skillBridge.createWorkspaceGroupFromNode",
    "onCommand:skillBridge.createCentralGroupFromNode",
    "onCommand:skillBridge.addWorkspaceSelectionToGroup",
    "onCommand:skillBridge.addCentralSelectionToGroup",
    "onCommand:skillBridge.createWorkspaceFolder",
    "onCommand:skillBridge.createWorkspaceFile",
    "onCommand:skillBridge.createWorkspaceSkill",
    "onCommand:skillBridge.quickWorkspaceCrud",
    "onCommand:skillBridge.smartWorkspaceActions",
    "onCommand:skillBridge.copyWorkspaceNode",
    "onCommand:skillBridge.pasteWorkspaceNode",
    "onCommand:skillBridge.renameWorkspaceNode",
    "onCommand:skillBridge.deleteWorkspaceNode",
    "onCommand:skillBridge.duplicateWorkspaceNode",
    "onCommand:skillBridge.createCentralFolder",
    "onCommand:skillBridge.createCentralFile",
    "onCommand:skillBridge.createCentralSkill",
    "onCommand:skillBridge.quickCentralCrud",
    "onCommand:skillBridge.smartCentralActions",
    "onCommand:skillBridge.copyCentralNode",
    "onCommand:skillBridge.pasteCentralNode",
    "onCommand:skillBridge.installSkills",
    "onCommand:skillBridge.viewSkillHistory",
    "onCommand:skillBridge.openTransferExplorer",
    "onCommand:skillBridge.openLibraryManager",
    "onCommand:skillBridge.openAddMoveWizard",
    "onCommand:skillBridge.hydrateProject",
    "onCommand:skillBridge.createCentralPack",
    "onCommand:skillBridge.setPersonalHome",
    "onCommand:skillBridge.resetPersonalHome",
    "onCommand:skillBridge.openWorkspaceFolder",
    "onCommand:skillBridge.openCentralFolder",
    "onCommand:skillBridge.switchTreeFilter",
    "onCommand:skillBridge.renameCentralNode",
    "onCommand:skillBridge.deleteCentralNode",
    "onCommand:skillBridge.duplicateCentralNode"
  ],
  "contributes": {
    "configuration": {
      "title": "Skill Bridge",
      "properties": {
        "skillBridge.centralRepoPath": {
          "type": "string",
          "default": "${userHome}/skill-bridge-repo",
          "description": "개인 중앙 스킬 저장소 경로. ${userHome}, ${workspaceFolder}, ${workspaceRoot}, ${env:NAME} 변수를 사용할 수 있습니다."
        },
        "skillBridge.defaultAgents": {
          "type": "array",
          "default": ["claude", "codex", "gemini", "cursor", "antigravity", "agents"],
          "items": {
            "type": "string",
            "enum": ["claude", "codex", "gemini", "cursor", "antigravity", "agents"]
          },
          "description": "관리 대상 에이전트"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillBridge",
          "title": "Skill Bridge",
          "icon": "resources/skill-bridge.svg"
        }
      ]
    },
    "views": {
      "skillBridge": [
        { "id": "skillBridge.workspaceSkills", "name": "Workspace 스킬" },
        { "id": "skillBridge.centralSkills", "name": "Central 스킬" }
      ]
    },
    "commands": [
      { "command": "skillBridge.refresh", "title": "새로고침", "category": "Skill Bridge", "icon": "$(refresh)" },
      { "command": "skillBridge.switchTab", "title": "에이전트 탭 전환", "category": "Skill Bridge", "icon": "$(list-tree)" },
      { "command": "skillBridge.promoteSelected", "title": "Central로 보내기", "category": "Skill Bridge" },
      { "command": "skillBridge.importSelected", "title": "Workspace로 가져오기", "category": "Skill Bridge" },
      { "command": "skillBridge.createWorkspaceGroup", "title": "Workspace 그룹 만들기", "category": "Skill Bridge" },
      { "command": "skillBridge.createCentralGroup", "title": "Central 그룹 만들기", "category": "Skill Bridge" },
      { "command": "skillBridge.promoteGroup", "title": "그룹을 Central로 보내기", "category": "Skill Bridge" },
      { "command": "skillBridge.importGroup", "title": "그룹을 Workspace로 가져오기", "category": "Skill Bridge" },
      { "command": "skillBridge.selectGroup", "title": "그룹 선택", "category": "Skill Bridge" },
      { "command": "skillBridge.deleteGroup", "title": "그룹 삭제", "category": "Skill Bridge" },
      { "command": "skillBridge.groupActions", "title": "그룹 작업", "category": "Skill Bridge" },
      { "command": "skillBridge.renameGroup", "title": "그룹 이름 바꾸기", "category": "Skill Bridge" },
      { "command": "skillBridge.createWorkspaceGroupFromNode", "title": "여기에 그룹 만들기", "category": "Skill Bridge" },
      { "command": "skillBridge.createCentralGroupFromNode", "title": "여기에 그룹 만들기", "category": "Skill Bridge" },
      { "command": "skillBridge.addWorkspaceSelectionToGroup", "title": "그룹에 추가", "category": "Skill Bridge" },
      { "command": "skillBridge.addCentralSelectionToGroup", "title": "그룹에 추가", "category": "Skill Bridge" },
      { "command": "skillBridge.createWorkspaceFolder", "title": "새 폴더", "category": "Skill Bridge" },
      { "command": "skillBridge.createWorkspaceFile", "title": "새 파일", "category": "Skill Bridge" },
      { "command": "skillBridge.createWorkspaceSkill", "title": "스킬 만들기 (SKILL.md)", "category": "Skill Bridge" },
      { "command": "skillBridge.quickWorkspaceCrud", "title": "스킬 파일 만들기/수정", "category": "Skill Bridge" },
      { "command": "skillBridge.smartWorkspaceActions", "title": "추천 작업", "category": "Skill Bridge" },
      { "command": "skillBridge.copyWorkspaceNode", "title": "복사", "category": "Skill Bridge" },
      { "command": "skillBridge.pasteWorkspaceNode", "title": "붙여넣기", "category": "Skill Bridge" },
      { "command": "skillBridge.renameWorkspaceNode", "title": "이름 바꾸기", "category": "Skill Bridge" },
      { "command": "skillBridge.deleteWorkspaceNode", "title": "삭제", "category": "Skill Bridge" },
      { "command": "skillBridge.duplicateWorkspaceNode", "title": "복제", "category": "Skill Bridge" },
      { "command": "skillBridge.createCentralFolder", "title": "새 폴더", "category": "Skill Bridge" },
      { "command": "skillBridge.createCentralFile", "title": "새 파일", "category": "Skill Bridge" },
      { "command": "skillBridge.createCentralSkill", "title": "스킬 만들기 (SKILL.md)", "category": "Skill Bridge" },
      { "command": "skillBridge.quickCentralCrud", "title": "스킬 파일 만들기/수정", "category": "Skill Bridge" },
      { "command": "skillBridge.smartCentralActions", "title": "추천 작업", "category": "Skill Bridge" },
      { "command": "skillBridge.copyCentralNode", "title": "복사", "category": "Skill Bridge" },
      { "command": "skillBridge.pasteCentralNode", "title": "붙여넣기", "category": "Skill Bridge" },
      { "command": "skillBridge.installSkills", "title": "npx로 스킬 설치", "category": "Skill Bridge" },
      { "command": "skillBridge.viewSkillHistory", "title": "스킬 이력 보기", "category": "Skill Bridge" },
      { "command": "skillBridge.openTransferExplorer", "title": "변경 비교/반영 열기 (Workspace ↔ Central)", "category": "Skill Bridge", "icon": "$(arrow-swap)" },
      { "command": "skillBridge.openLibraryManager", "title": "스킬 보관함 열기", "category": "Skill Bridge", "icon": "$(library)" },
      { "command": "skillBridge.openAddMoveWizard", "title": "스킬 추가/이동 열기", "category": "Skill Bridge", "icon": "$(add)" },
      { "command": "skillBridge.hydrateProject", "title": "현재 프로젝트에 스킬 채우기", "category": "Skill Bridge", "icon": "$(repo-pull)" },
      { "command": "skillBridge.createCentralPack", "title": "개인 스킬 묶음 만들기", "category": "Skill Bridge", "icon": "$(package)" },
      { "command": "skillBridge.setPersonalHome", "title": "개인 중앙 스킬 폴더 설정", "category": "Skill Bridge", "icon": "$(home)" },
      { "command": "skillBridge.resetPersonalHome", "title": "개인 중앙 스킬 폴더 초기화", "category": "Skill Bridge", "icon": "$(discard)" },
      { "command": "skillBridge.openWorkspaceFolder", "title": "Workspace 폴더 열기", "category": "Skill Bridge", "icon": "$(folder-opened)" },
      { "command": "skillBridge.openCentralFolder", "title": "Central 폴더 열기", "category": "Skill Bridge", "icon": "$(folder-opened)" },
      { "command": "skillBridge.switchTreeFilter", "title": "트리 필터 전환", "category": "Skill Bridge", "icon": "$(filter)" },
      { "command": "skillBridge.renameCentralNode", "title": "이름 바꾸기", "category": "Skill Bridge" },
      { "command": "skillBridge.deleteCentralNode", "title": "삭제", "category": "Skill Bridge" },
      { "command": "skillBridge.duplicateCentralNode", "title": "복제", "category": "Skill Bridge" },
      { "command": "skillBridge.selectWorkspaceNode", "title": "Select Workspace Node", "category": "Skill Bridge" },
      { "command": "skillBridge.selectCentralNode", "title": "Select Central Node", "category": "Skill Bridge" }
    ],
    "submenus": [
      { "id": "skillBridge.workspaceFileActions", "label": "파일 작업" },
      { "id": "skillBridge.centralFileActions", "label": "파일 작업" },
      { "id": "skillBridge.workspaceAdvanced", "label": "고급" },
      { "id": "skillBridge.centralAdvanced", "label": "고급" },
      { "id": "skillBridge.globalTools", "label": "Skill Bridge 도구" },
      { "id": "skillBridge.settings", "label": "설정" }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillBridge.refresh",
          "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills",
          "group": "navigation@1"
        },
        {
          "command": "skillBridge.switchTab",
          "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills",
          "group": "secondary@1"
        },
        {
          "command": "skillBridge.switchTreeFilter",
          "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills",
          "group": "navigation@2"
        },
        {
          "command": "skillBridge.openWorkspaceFolder",
          "when": "view == skillBridge.workspaceSkills",
          "group": "navigation@3"
        },
        {
          "command": "skillBridge.openCentralFolder",
          "when": "view == skillBridge.centralSkills",
          "group": "navigation@3"
        },
        {
          "command": "skillBridge.openLibraryManager",
          "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills",
          "group": "navigation@4"
        },
        {
          "command": "skillBridge.openTransferExplorer",
          "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills",
          "group": "secondary@2"
        },
        {
          "command": "skillBridge.openAddMoveWizard",
          "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills",
          "group": "secondary@3"
        },
        {
          "command": "skillBridge.hydrateProject",
          "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills",
          "group": "secondary@4"
        },
        {
          "command": "skillBridge.createCentralPack",
          "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills",
          "group": "secondary@5"
        },
        {
          "command": "skillBridge.setPersonalHome",
          "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills",
          "group": "secondary@6"
        },
        {
          "command": "skillBridge.resetPersonalHome",
          "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills",
          "group": "secondary@7"
        }
      ],
      "view/item/context": [
        {
          "command": "skillBridge.openWorkspaceFolder",
          "when": "view == skillBridge.workspaceSkills && (viewItem == skillBridge.file || viewItem == skillBridge.folder || viewItem == skillBridge.skillsRoot || viewItem == skillBridge.folderRoot)",
          "group": "navigation@0"
        },
        {
          "command": "skillBridge.promoteSelected",
          "when": "view == skillBridge.workspaceSkills && (viewItem == skillBridge.file || viewItem == skillBridge.folder || viewItem == skillBridge.skillsRoot || viewItem == skillBridge.folderRoot)",
          "group": "navigation@1"
        },
        {
          "command": "skillBridge.addWorkspaceSelectionToGroup",
          "when": "view == skillBridge.workspaceSkills && (viewItem == skillBridge.file || viewItem == skillBridge.folder)",
          "group": "navigation@2"
        },
        {
          "submenu": "skillBridge.workspaceFileActions",
          "when": "view == skillBridge.workspaceSkills && (viewItem == skillBridge.file || viewItem == skillBridge.folder || viewItem == skillBridge.skillsRoot || viewItem == skillBridge.folderRoot)",
          "group": "navigation@3"
        },
        {
          "submenu": "skillBridge.workspaceAdvanced",
          "when": "view == skillBridge.workspaceSkills && (viewItem == skillBridge.file || viewItem == skillBridge.folder || viewItem == skillBridge.skillsRoot || viewItem == skillBridge.folderRoot)",
          "group": "navigation@4"
        },
        {
          "command": "skillBridge.openCentralFolder",
          "when": "view == skillBridge.centralSkills && (viewItem == skillBridge.file || viewItem == skillBridge.folder || viewItem == skillBridge.skillsRoot || viewItem == skillBridge.folderRoot)",
          "group": "navigation@0"
        },
        {
          "command": "skillBridge.importSelected",
          "when": "view == skillBridge.centralSkills && (viewItem == skillBridge.file || viewItem == skillBridge.folder || viewItem == skillBridge.skillsRoot || viewItem == skillBridge.folderRoot)",
          "group": "navigation@1"
        },
        {
          "command": "skillBridge.addCentralSelectionToGroup",
          "when": "view == skillBridge.centralSkills && (viewItem == skillBridge.file || viewItem == skillBridge.folder)",
          "group": "navigation@2"
        },
        {
          "submenu": "skillBridge.centralFileActions",
          "when": "view == skillBridge.centralSkills && (viewItem == skillBridge.file || viewItem == skillBridge.folder || viewItem == skillBridge.skillsRoot || viewItem == skillBridge.folderRoot)",
          "group": "navigation@3"
        },
        {
          "submenu": "skillBridge.centralAdvanced",
          "when": "view == skillBridge.centralSkills && (viewItem == skillBridge.file || viewItem == skillBridge.folder || viewItem == skillBridge.skillsRoot || viewItem == skillBridge.folderRoot)",
          "group": "navigation@4"
        },
        {
          "command": "skillBridge.groupActions",
          "when": "(view == skillBridge.workspaceSkills || view == skillBridge.centralSkills) && (viewItem == skillBridge.group.workspace || viewItem == skillBridge.group.central)",
          "group": "navigation@1"
        },
        {
          "command": "skillBridge.renameGroup",
          "when": "(view == skillBridge.workspaceSkills || view == skillBridge.centralSkills) && (viewItem == skillBridge.group.workspace || viewItem == skillBridge.group.central)",
          "group": "navigation@1.1"
        },
        {
          "command": "skillBridge.deleteGroup",
          "when": "(view == skillBridge.workspaceSkills || view == skillBridge.centralSkills) && (viewItem == skillBridge.group.workspace || viewItem == skillBridge.group.central)",
          "group": "navigation@1.2"
        },
        {
          "submenu": "skillBridge.globalTools",
          "when": "(view == skillBridge.workspaceSkills || view == skillBridge.centralSkills) && (viewItem == skillBridge.folderRoot || viewItem == skillBridge.skillsRoot || viewItem == skillBridge.folder)",
          "group": "z_global@1"
        },
        {
          "submenu": "skillBridge.settings",
          "when": "(view == skillBridge.workspaceSkills || view == skillBridge.centralSkills) && (viewItem == skillBridge.folderRoot || viewItem == skillBridge.skillsRoot || viewItem == skillBridge.folder)",
          "group": "z_settings@1"
        }
      ],
      "skillBridge.workspaceFileActions": [
        {
          "command": "skillBridge.openWorkspaceFolder",
          "group": "navigation@0"
        },
        {
          "command": "skillBridge.createWorkspaceSkill",
          "group": "navigation@1"
        },
        {
          "command": "skillBridge.createWorkspaceFolder",
          "group": "navigation@2"
        },
        {
          "command": "skillBridge.createWorkspaceFile",
          "group": "navigation@3"
        },
        {
          "command": "skillBridge.renameWorkspaceNode",
          "when": "viewItem == skillBridge.file || viewItem == skillBridge.folder",
          "group": "2_edit@1"
        },
        {
          "command": "skillBridge.duplicateWorkspaceNode",
          "when": "viewItem == skillBridge.file || viewItem == skillBridge.folder",
          "group": "2_edit@2"
        },
        {
          "command": "skillBridge.deleteWorkspaceNode",
          "when": "viewItem == skillBridge.file || viewItem == skillBridge.folder",
          "group": "2_edit@3"
        },
        {
          "command": "skillBridge.copyWorkspaceNode",
          "when": "viewItem == skillBridge.file || viewItem == skillBridge.folder",
          "group": "3_clipboard@1"
        },
        {
          "command": "skillBridge.pasteWorkspaceNode",
          "group": "3_clipboard@2"
        }
      ],
      "skillBridge.centralFileActions": [
        {
          "command": "skillBridge.openCentralFolder",
          "group": "navigation@0"
        },
        {
          "command": "skillBridge.createCentralSkill",
          "group": "navigation@1"
        },
        {
          "command": "skillBridge.createCentralFolder",
          "group": "navigation@2"
        },
        {
          "command": "skillBridge.createCentralFile",
          "group": "navigation@3"
        },
        {
          "command": "skillBridge.renameCentralNode",
          "when": "viewItem == skillBridge.file || viewItem == skillBridge.folder",
          "group": "2_edit@1"
        },
        {
          "command": "skillBridge.duplicateCentralNode",
          "when": "viewItem == skillBridge.file || viewItem == skillBridge.folder",
          "group": "2_edit@2"
        },
        {
          "command": "skillBridge.deleteCentralNode",
          "when": "viewItem == skillBridge.file || viewItem == skillBridge.folder",
          "group": "2_edit@3"
        },
        {
          "command": "skillBridge.copyCentralNode",
          "when": "viewItem == skillBridge.file || viewItem == skillBridge.folder",
          "group": "3_clipboard@1"
        },
        {
          "command": "skillBridge.pasteCentralNode",
          "group": "3_clipboard@2"
        }
      ],
      "skillBridge.workspaceAdvanced": [
        {
          "command": "skillBridge.createWorkspaceGroupFromNode",
          "when": "viewItem == skillBridge.file || viewItem == skillBridge.folder",
          "group": "navigation@1"
        },
        {
          "command": "skillBridge.createWorkspaceGroup",
          "group": "navigation@2"
        },
        {
          "command": "skillBridge.smartWorkspaceActions",
          "group": "2_tools@1"
        },
        {
          "command": "skillBridge.quickWorkspaceCrud",
          "group": "2_tools@2"
        },
        {
          "command": "skillBridge.installSkills",
          "group": "3_review@1"
        },
        {
          "command": "skillBridge.viewSkillHistory",
          "group": "3_review@2"
        }
      ],
      "skillBridge.centralAdvanced": [
        {
          "command": "skillBridge.createCentralGroupFromNode",
          "when": "viewItem == skillBridge.file || viewItem == skillBridge.folder",
          "group": "navigation@1"
        },
        {
          "command": "skillBridge.createCentralGroup",
          "group": "navigation@2"
        },
        {
          "command": "skillBridge.smartCentralActions",
          "group": "2_tools@1"
        },
        {
          "command": "skillBridge.quickCentralCrud",
          "group": "2_tools@2"
        },
        {
          "command": "skillBridge.installSkills",
          "group": "3_review@1"
        },
        {
          "command": "skillBridge.viewSkillHistory",
          "group": "3_review@2"
        }
      ],
      "skillBridge.globalTools": [
        {
          "command": "skillBridge.openTransferExplorer",
          "group": "navigation@1"
        },
        {
          "command": "skillBridge.openAddMoveWizard",
          "group": "navigation@2"
        },
        {
          "command": "skillBridge.hydrateProject",
          "group": "navigation@3"
        },
        {
          "command": "skillBridge.createCentralPack",
          "group": "navigation@4"
        }
      ],
      "skillBridge.settings": [
        {
          "command": "skillBridge.setPersonalHome",
          "group": "navigation@1"
        },
        {
          "command": "skillBridge.resetPersonalHome",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        { "command": "skillBridge.openWorkspaceFolder" },
        { "command": "skillBridge.openCentralFolder" },
        { "command": "skillBridge.selectWorkspaceNode", "when": "false" },
        { "command": "skillBridge.selectCentralNode", "when": "false" },
        { "command": "skillBridge.selectGroup", "when": "false" },
        { "command": "skillBridge.deleteGroup", "when": "false" },
        { "command": "skillBridge.groupActions", "when": "false" },
        { "command": "skillBridge.renameGroup", "when": "false" },
        { "command": "skillBridge.createWorkspaceGroupFromNode", "when": "false" },
        { "command": "skillBridge.createCentralGroupFromNode", "when": "false" },
        { "command": "skillBridge.addWorkspaceSelectionToGroup", "when": "false" },
        { "command": "skillBridge.addCentralSelectionToGroup", "when": "false" },
        { "command": "skillBridge.createWorkspaceFolder", "when": "false" },
        { "command": "skillBridge.createWorkspaceFile", "when": "false" },
        { "command": "skillBridge.createWorkspaceSkill", "when": "false" },
        { "command": "skillBridge.quickWorkspaceCrud", "when": "false" },
        { "command": "skillBridge.smartWorkspaceActions", "when": "false" },
        { "command": "skillBridge.copyWorkspaceNode", "when": "false" },
        { "command": "skillBridge.pasteWorkspaceNode", "when": "false" },
        { "command": "skillBridge.renameWorkspaceNode", "when": "false" },
        { "command": "skillBridge.deleteWorkspaceNode", "when": "false" },
        { "command": "skillBridge.duplicateWorkspaceNode", "when": "false" },
        { "command": "skillBridge.createCentralFolder", "when": "false" },
        { "command": "skillBridge.createCentralFile", "when": "false" },
        { "command": "skillBridge.createCentralSkill", "when": "false" },
        { "command": "skillBridge.quickCentralCrud", "when": "false" },
        { "command": "skillBridge.smartCentralActions", "when": "false" },
        { "command": "skillBridge.copyCentralNode", "when": "false" },
        { "command": "skillBridge.pasteCentralNode", "when": "false" },
        { "command": "skillBridge.installSkills", "when": "false" },
        { "command": "skillBridge.viewSkillHistory", "when": "false" },
        { "command": "skillBridge.switchTreeFilter", "when": "false" },
        { "command": "skillBridge.renameCentralNode", "when": "false" },
        { "command": "skillBridge.deleteCentralNode", "when": "false" },
        { "command": "skillBridge.duplicateCentralNode", "when": "false" }
      ]
    },
    "keybindings": [
      {
        "command": "skillBridge.renameWorkspaceNode",
        "key": "f2",
        "when": "listFocus && view == skillBridge.workspaceSkills"
      },
      {
        "command": "skillBridge.renameCentralNode",
        "key": "f2",
        "when": "listFocus && view == skillBridge.centralSkills"
      },
      {
        "command": "skillBridge.renameGroup",
        "key": "f2",
        "when": "listFocus && (view == skillBridge.workspaceSkills || view == skillBridge.centralSkills) && (viewItem == skillBridge.group.workspace || viewItem == skillBridge.group.central)"
      },
      {
        "command": "skillBridge.deleteWorkspaceNode",
        "key": "delete",
        "when": "listFocus && view == skillBridge.workspaceSkills"
      },
      {
        "command": "skillBridge.deleteCentralNode",
        "key": "delete",
        "when": "listFocus && view == skillBridge.centralSkills"
      },
      {
        "command": "skillBridge.deleteGroup",
        "key": "delete",
        "when": "listFocus && (view == skillBridge.workspaceSkills || view == skillBridge.centralSkills) && (viewItem == skillBridge.group.workspace || viewItem == skillBridge.group.central)"
      },
      {
        "command": "skillBridge.duplicateWorkspaceNode",
        "key": "ctrl+d",
        "when": "listFocus && view == skillBridge.workspaceSkills"
      },
      {
        "command": "skillBridge.duplicateCentralNode",
        "key": "ctrl+d",
        "when": "listFocus && view == skillBridge.centralSkills"
      },
      {
        "command": "skillBridge.copyWorkspaceNode",
        "key": "ctrl+c",
        "when": "listFocus && view == skillBridge.workspaceSkills"
      },
      {
        "command": "skillBridge.copyCentralNode",
        "key": "ctrl+c",
        "when": "listFocus && view == skillBridge.centralSkills"
      },
      {
        "command": "skillBridge.pasteWorkspaceNode",
        "key": "ctrl+v",
        "when": "listFocus && view == skillBridge.workspaceSkills"
      },
      {
        "command": "skillBridge.pasteCentralNode",
        "key": "ctrl+v",
        "when": "listFocus && view == skillBridge.centralSkills"
      },
      {
        "command": "skillBridge.openLibraryManager",
        "key": "ctrl+alt+l"
      },
      {
        "command": "skillBridge.openAddMoveWizard",
        "key": "ctrl+alt+a"
      },
      {
        "command": "skillBridge.openTransferExplorer",
        "key": "ctrl+alt+x"
      },
      {
        "command": "skillBridge.hydrateProject",
        "key": "ctrl+alt+h"
      },
      {
        "command": "skillBridge.switchTreeFilter",
        "key": "ctrl+alt+f",
        "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills"
      },
      {
        "command": "skillBridge.switchTab",
        "key": "ctrl+alt+t",
        "when": "view == skillBridge.workspaceSkills || view == skillBridge.centralSkills"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check:manifest": "node scripts/check-manifest.cjs",
    "package:vsix": "npx vsce package --allow-missing-repository --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}

