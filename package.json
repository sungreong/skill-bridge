{
  "name": "skill-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Bridge VS Code extension",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:core\" \"npm run dev:vscode\"",
    "check:max-lines": "node scripts/check-max-lines.cjs",
    "check:webviews": "node scripts/check-webviews.cjs",
    "check:file-ops-workflow": "node scripts/check-file-ops-workflow.cjs",
    "check:file-ops-comparers": "node scripts/check-file-ops-comparers.cjs",
    "check:performance-tools": "node scripts/check-performance-tools.cjs",
    "check:performance-status": "node scripts/check-performance-status.cjs",
    "check:prepare-performance-artifacts": "node scripts/check-prepare-performance-artifacts.cjs",
    "check:refresh-timings": "node scripts/check-refresh-timings.cjs",
    "check:write-if-changed": "npm run build:vscode && node scripts/check-write-if-changed.cjs",
    "check:verify-performance-artifacts": "node scripts/check-verify-performance-artifacts.cjs",
    "check:vscode-runtime-deps": "node scripts/check-vscode-runtime-deps.cjs",
    "check:vsix-runtime-deps": "node scripts/check-vsix-runtime-deps.cjs",
    "check:manifest": "npm --workspace apps/vscode run check:manifest",
    "check:action-labels": "npm --workspace apps/vscode run check:action-labels",
    "check:context-menu-density": "node scripts/check-context-menu-density.cjs",
    "check:pre-vsix": "npm --workspace apps/vscode run check:pre-vsix",
    "check:prepush": "npm run typecheck && npm --workspace apps/vscode run check:pre-vsix",
    "prepush": "npm run check:prepush",
    "dev:core": "tsc -p packages/core/tsconfig.json --watch",
    "dev:vscode": "tsc -p apps/vscode/tsconfig.json --watch",
    "build": "npm run build:core && npm run build:vscode",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "build:vscode": "npm --workspace apps/vscode run build",
    "test:file-ops": "npm run build && npm run test:file-ops:dist",
    "test:file-ops:dist": "node scripts/test-file-ops-cross-platform.cjs",
    "test:central-paths": "node scripts/test-central-paths.cjs",
    "benchmark:file-ops": "npm run build && npm run benchmark:file-ops:dist",
    "benchmark:file-ops:dist": "node scripts/benchmark-file-ops.cjs",
    "benchmark:file-ops:loading": "npm run build && npm run benchmark:file-ops:dist -- --preset loading --include-control",
    "benchmark:file-ops:transfer": "npm run build && npm run benchmark:file-ops:dist -- --preset transfer --include-control",
    "compare:file-ops-artifacts": "node scripts/compare-file-ops-artifacts.cjs",
    "compare:loading-file-ops-artifacts": "node scripts/compare-file-ops-artifacts.cjs --prefix loading-file-ops",
    "compare:transfer-file-ops-artifacts": "node scripts/compare-file-ops-artifacts.cjs --prefix transfer-file-ops",
    "compare:smoke-file-ops-artifacts": "node scripts/compare-smoke-file-ops-artifacts.cjs",
    "compare:vsix-artifacts": "node scripts/compare-vsix-artifacts.cjs",
    "prepare:performance-artifacts": "node scripts/prepare-performance-artifacts.cjs",
    "verify:performance-artifacts": "node scripts/verify-performance-artifacts.cjs",
    "summarize:refresh-timings": "node scripts/summarize-refresh-timings.cjs",
    "report:performance-status": "node scripts/report-performance-status.cjs",
    "check:performance": "node scripts/check-performance.cjs",
    "test:vscode:npx-skill-add": "npm run build:vscode && node scripts/test-vscode-skills-add.cjs",
    "typecheck": "npm run check:max-lines && tsc -p packages/core/tsconfig.json --noEmit && tsc -p apps/vscode/tsconfig.json --noEmit",
    "dist": "npm run build && npm --workspace apps/vscode run package:vsix"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "diff": "^8.0.2"
  }
}
